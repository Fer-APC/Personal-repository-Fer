{
  "name": "training-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adaptive gym routine planner and training log that works around your runs and beach volley sessions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "test": "node scripts/run-tests.mjs",
    "build:single": "npm run build && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
